<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ClassIsland.Controls"
        xmlns:ci="http://classisland.tech/schemas/xaml/core"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:classIsland="using:ClassIsland">
    <Styles.Resources>
        <ci:WidthDoubleToRectConverter x:Key="WidthDoubleToRectConverter" />
        <ci:ColorToColorPickerBrushConverter x:Key="ColorToColorPickerBrushConverter" />
        <ci:SizeDoubleToCornerRadiusConverter x:Key="SizeDoubleToCornerRadiusConverter" />
        <ci:BooleanToBooleanReConverter x:Key="InvertBooleanConverter" />
        <ci:DoubleToThicknessMultiConverter x:Key="DoubleToThicknessMultiConverter" />
        <system:Double x:Key="IslandContainerHeight">40</system:Double>

        <LinearGradientBrush x:Key="LiquidGlassBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#60181828" Offset="0"/>
                <GradientStop Color="#48101020" Offset="0.45"/>
                <GradientStop Color="#400C0C1A" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LiquidGlassHighlightBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#28FFFFFF" Offset="0"/>
                <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LiquidGlassBorderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#40FFFFFF" Offset="0"/>
                <GradientStop Color="#10FFFFFF" Offset="0.5"/>
                <GradientStop Color="#25FFFFFF" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LiquidGlassMaskOverlayBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <LinearGradientBrush.GradientStops>
                <GradientStop Color="#18FFFFFF" Offset="0"/>
                <GradientStop Color="#06FFFFFF" Offset="1"/>
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>

        <!-- ===== 跑马灯彩虹色画刷 ===== -->
        <SolidColorBrush x:Key="RL_Red" Color="#FFFF3B3B"/>
        <SolidColorBrush x:Key="RL_Orange" Color="#FFFF9F3B"/>
        <SolidColorBrush x:Key="RL_Yellow" Color="#FFFFF73B"/>
        <SolidColorBrush x:Key="RL_Green" Color="#FF3BFF8C"/>
        <SolidColorBrush x:Key="RL_Cyan" Color="#FF3BD4FF"/>
        <SolidColorBrush x:Key="RL_Blue" Color="#FF7B3BFF"/>
        <SolidColorBrush x:Key="RL_Purple" Color="#FFFF3BE2"/>
    </Styles.Resources>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- ===== 基础背景样式（已移除旧的 BoxShadow 跑马灯动画） ===== -->
    <Style Selector="Border.line-background">
        <Setter Property="Background" Value="{StaticResource LiquidGlassBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"/>
        <Setter Property="Opacity" Value="{Binding $self.(ci:MainWindowStylesAssist.BackgroundOpacity), Mode=OneWay}"/>
        <Setter Property="BoxShadow" Value="0 2 16 0 #30000000, 0 0 1 0 #10FFFFFF inset"/>
    </Style>
    <Style Selector="controls|MainWindowLine Border[(ci|MainWindowStylesAssist.IsCustomBackgroundColorEnabled)=True].line-background">
        <Setter Property="Background" Value="{Binding $self.(ci:MainWindowStylesAssist.BackgroundColor), Converter={StaticResource ColorToColorPickerBrushConverter}}"/>
    </Style>

    <!-- ===== 跑马灯灯泡基础样式（7 个一组，跑马灯流转周期约 3.15 秒） ===== -->
    <Style Selector="Rectangle.rl-bulb">
        <Setter Property="Opacity" Value="0.15"/>
        <Setter Property="RadiusX" Value="1"/>
        <Setter Property="RadiusY" Value="1"/>
    </Style>

    <!-- 跑马灯灯泡流光动画：每个灯泡依次亮起，错开 0.45 秒 -->
    <Style Selector="Rectangle.rl-delay-0">
        <Style.Animations>
            <Animation Delay="0:0:0.00" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-delay-1">
        <Style.Animations>
            <Animation Delay="0:0:0.45" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-delay-2">
        <Style.Animations>
            <Animation Delay="0:0:0.90" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-delay-3">
        <Style.Animations>
            <Animation Delay="0:0:1.35" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-delay-4">
        <Style.Animations>
            <Animation Delay="0:0:1.80" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-delay-5">
        <Style.Animations>
            <Animation Delay="0:0:2.25" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-delay-6">
        <Style.Animations>
            <Animation Delay="0:0:2.70" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- 右侧边灯泡：错开 0.3s 使整圈顺时针流转 -->
    <Style Selector="Rectangle.rl-right.rl-delay-0">
        <Style.Animations>
            <Animation Delay="0:0:0.30" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-right.rl-delay-1">
        <Style.Animations>
            <Animation Delay="0:0:0.75" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-right.rl-delay-2">
        <Style.Animations>
            <Animation Delay="0:0:1.20" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-right.rl-delay-3">
        <Style.Animations>
            <Animation Delay="0:0:1.65" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-right.rl-delay-4">
        <Style.Animations>
            <Animation Delay="0:0:2.10" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-right.rl-delay-5">
        <Style.Animations>
            <Animation Delay="0:0:2.55" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-right.rl-delay-6">
        <Style.Animations>
            <Animation Delay="0:0:3.00" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- 底侧边灯泡：再错开 0.3s -->
    <Style Selector="Rectangle.rl-bottom.rl-delay-0">
        <Style.Animations>
            <Animation Delay="0:0:0.60" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-bottom.rl-delay-1">
        <Style.Animations>
            <Animation Delay="0:0:1.05" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-bottom.rl-delay-2">
        <Style.Animations>
            <Animation Delay="0:0:1.50" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-bottom.rl-delay-3">
        <Style.Animations>
            <Animation Delay="0:0:1.95" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-bottom.rl-delay-4">
        <Style.Animations>
            <Animation Delay="0:0:2.40" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-bottom.rl-delay-5">
        <Style.Animations>
            <Animation Delay="0:0:2.85" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-bottom.rl-delay-6">
        <Style.Animations>
            <Animation Delay="0:0:3.30" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- 左侧边灯泡：再错开 0.3s -->
    <Style Selector="Rectangle.rl-left.rl-delay-0">
        <Style.Animations>
            <Animation Delay="0:0:0.90" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-left.rl-delay-1">
        <Style.Animations>
            <Animation Delay="0:0:1.35" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-left.rl-delay-2">
        <Style.Animations>
            <Animation Delay="0:0:1.80" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-left.rl-delay-3">
        <Style.Animations>
            <Animation Delay="0:0:2.25" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-left.rl-delay-4">
        <Style.Animations>
            <Animation Delay="0:0:2.70" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-left.rl-delay-5">
        <Style.Animations>
            <Animation Delay="0:0:3.15" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Rectangle.rl-left.rl-delay-6">
        <Style.Animations>
            <Animation Delay="0:0:3.60" Duration="0:0:3.15" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="7%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                <KeyFrame Cue="14%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.15"/></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="controls|MainWindowLine">
        <Style.Resources>
            <ControlTemplate x:Key="MainWindowLineFullControlTemplate" TargetType="controls:MainWindowLine">
                <Grid ClipToBounds="False"
                      x:Name="GridRoot"
                      HorizontalAlignment="Stretch">

                    <Border x:Name="BackgroundBorderWrapper"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}">
                        <Grid>
                            <Border x:Name="BackgroundBorder"
                                    Classes="docking line-background"
                                    Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}"
                                    Height="{DynamicResource IslandContainerHeight}"/>

                            <!-- ========================================== -->
                            <!-- 多色跑马灯：距离边缘约 1mm（4px）的彩虹流光    -->
                            <!-- 每边 7 个彩色灯泡，按顺时针方向依次亮起        -->
                            <!-- ========================================== -->
                            <Grid Margin="4"
                                  IsHitTestVisible="False"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch">
                                <!-- 顶边：从左到右流光，水平排列 7 色 -->
                                <Grid VerticalAlignment="Top"
                                      HorizontalAlignment="Stretch"
                                      Height="2"
                                      Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Classes="rl-bulb rl-delay-0" Grid.Column="0" Fill="{StaticResource RL_Red}" Margin="0,0,2,0"/>
                                    <Rectangle Classes="rl-bulb rl-delay-1" Grid.Column="1" Fill="{StaticResource RL_Orange}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-delay-2" Grid.Column="2" Fill="{StaticResource RL_Yellow}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-delay-3" Grid.Column="3" Fill="{StaticResource RL_Green}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-delay-4" Grid.Column="4" Fill="{StaticResource RL_Cyan}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-delay-5" Grid.Column="5" Fill="{StaticResource RL_Blue}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-delay-6" Grid.Column="6" Fill="{StaticResource RL_Purple}" Margin="2,0,0,0"/>
                                </Grid>

                                <!-- 右侧：从上到下流光，垂直排列 7 色 -->
                                <Grid HorizontalAlignment="Right"
                                      VerticalAlignment="Stretch"
                                      Width="2"
                                      Margin="0,8,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Classes="rl-bulb rl-right rl-delay-0" Grid.Row="0" Fill="{StaticResource RL_Purple}" Margin="0,0,0,1"/>
                                    <Rectangle Classes="rl-bulb rl-right rl-delay-1" Grid.Row="1" Fill="{StaticResource RL_Red}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-right rl-delay-2" Grid.Row="2" Fill="{StaticResource RL_Orange}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-right rl-delay-3" Grid.Row="3" Fill="{StaticResource RL_Yellow}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-right rl-delay-4" Grid.Row="4" Fill="{StaticResource RL_Green}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-right rl-delay-5" Grid.Row="5" Fill="{StaticResource RL_Cyan}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-right rl-delay-6" Grid.Row="6" Fill="{StaticResource RL_Blue}" Margin="0,1,0,0"/>
                                </Grid>

                                <!-- 底边：从右到左流光，水平排列 7 色（反转） -->
                                <Grid VerticalAlignment="Bottom"
                                      HorizontalAlignment="Stretch"
                                      Height="2"
                                      Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Classes="rl-bulb rl-bottom rl-delay-0" Grid.Column="6" Fill="{StaticResource RL_Red}" Margin="2,0,0,0"/>
                                    <Rectangle Classes="rl-bulb rl-bottom rl-delay-1" Grid.Column="5" Fill="{StaticResource RL_Orange}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-bottom rl-delay-2" Grid.Column="4" Fill="{StaticResource RL_Yellow}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-bottom rl-delay-3" Grid.Column="3" Fill="{StaticResource RL_Green}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-bottom rl-delay-4" Grid.Column="2" Fill="{StaticResource RL_Cyan}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-bottom rl-delay-5" Grid.Column="1" Fill="{StaticResource RL_Blue}" Margin="1,0"/>
                                    <Rectangle Classes="rl-bulb rl-bottom rl-delay-6" Grid.Column="0" Fill="{StaticResource RL_Purple}" Margin="0,0,2,0"/>
                                </Grid>

                                <!-- 左侧：从下到上流光，垂直排列 7 色（反转） -->
                                <Grid HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"
                                      Width="2"
                                      Margin="0,8,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Classes="rl-bulb rl-left rl-delay-0" Grid.Row="6" Fill="{StaticResource RL_Purple}" Margin="0,1,0,0"/>
                                    <Rectangle Classes="rl-bulb rl-left rl-delay-1" Grid.Row="5" Fill="{StaticResource RL_Red}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-left rl-delay-2" Grid.Row="4" Fill="{StaticResource RL_Orange}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-left rl-delay-3" Grid.Row="3" Fill="{StaticResource RL_Yellow}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-left rl-delay-4" Grid.Row="2" Fill="{StaticResource RL_Green}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-left rl-delay-5" Grid.Row="1" Fill="{StaticResource RL_Cyan}" Margin="0,1"/>
                                    <Rectangle Classes="rl-bulb rl-left rl-delay-6" Grid.Row="0" Fill="{StaticResource RL_Blue}" Margin="0,0,0,1"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="BackgroundBorderOverlayMask"
                            Classes="docking primaryColorZone"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            Opacity="0"
                            VerticalAlignment="Stretch"
                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                            ClipToBounds="True"
                            Height="{DynamicResource IslandContainerHeight}"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}">
                        <Border.Transitions>
                            <Transitions>
                                <BoxShadowsTransition Duration="0:0:0.15" Property="BoxShadow"/>
                            </Transitions>
                        </Border.Transitions>
                    </Border>

                    <Border x:Name="GlassHighlightOverlay"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            IsHitTestVisible="False"
                            Background="{StaticResource LiquidGlassHighlightBrush}"
                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                            Height="{DynamicResource IslandContainerHeight}"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}"
                            ClipToBounds="True"
                            Opacity="0.7"/>

                    <Grid x:Name="ContentClipBorder" Classes="clip-host">
                        <Panel Classes="animated-resize" ClipToBounds="False">
                            <Grid x:Name="PART_GridWrapper" ClipToBounds="False"
                                  Height="{DynamicResource IslandContainerHeight}"
                                  Classes="docking">
                                <Grid Height="{DynamicResource IslandContainerHeight}"
                                      x:Name="GridContentRoot"
                                      MinWidth="20"
                                      Margin="12 0">
                                    <ContentPresenter
                                        Content="{Binding Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}" />
                                </Grid>

                                <Grid x:Name="GridOverlay"
                                      ClipToBounds="False"
                                      Opacity="0">
                                    <Border
                                        Classes.line-background="{Binding $self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding $self.(ci:MainWindowStylesAssist.IsIslandSeperated)}" />
                                    <Border ClipToBounds="True"
                                            IsHitTestVisible="False"
                                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                                        <Panel>
                                            <Canvas VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Stretch"
                                                    x:Name="ProgressContainer"
                                                    Height="{Binding #OverlayTimeProgressBar.Bounds.Height}">
                                                <ProgressBar VerticalAlignment="Bottom"
                                                             Maximum="1"
                                                             Value="{Binding CountdownProgressValue, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}"
                                                             x:Name="OverlayTimeProgressBar"
                                                             Width="{Binding #ProgressContainer.Bounds.Width, Mode=OneWay}"
                                                             MinWidth="0">
                                                    <ProgressBar.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="Value" Duration="0:0:0.05">
                                                                <DoubleTransition.Easing>
                                                                    <LinearEasing/>
                                                                </DoubleTransition.Easing>
                                                            </DoubleTransition>
                                                        </Transitions>
                                                    </ProgressBar.Transitions>
                                                </ProgressBar>
                                            </Canvas>
                                            <ContentPresenter
                                                MaxHeight="{DynamicResource IslandContainerHeight}"
                                                Content="{Binding OverlayContent.Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}"
                                                ContentTemplate="{Binding OverlayContent.ContentTemplate, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}" />
                                        </Panel>
                                    </Border>
                                </Grid>

                                <Border x:Name="OverlayMaskShadowRoot"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                                    <Border x:Name="OverlayMask"
                                            TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                            CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Height="{DynamicResource IslandContainerHeight}"
                                            RenderTransformOrigin="{x:Static RelativePoint.Center}">
                                        <Border.Transitions>
                                            <Transitions>
                                                <BoxShadowsTransition Duration="0:0:0.15" Property="BoxShadow" />
                                            </Transitions>
                                        </Border.Transitions>
                                        <Panel>
                                            <controls:SlantedMaskControl x:Name="SlantedMaskControlSeperated"
                                                                         Classes="mask-bg"
                                                                         ClipToBounds="True"
                                                                         RegionDurationMs="400"
                                                                         StageStaggerMs="140"
                                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Border
                                                TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                Padding="12 0">
                                                <ContentPresenter x:Name="OverlayMaskContent"
                                                                  Opacity="0"
                                                                  Content="{Binding MaskContent.Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}"
                                                                  ContentTemplate="{Binding MaskContent.ContentTemplate, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}">
                                                    <ContentPresenter.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform />
                                                        </TransformGroup>
                                                    </ContentPresenter.RenderTransform>
                                                </ContentPresenter>
                                            </Border>
                                        </Panel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Panel>
                    </Grid>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="MainWindowLineMinControlTemplate" TargetType="controls:MainWindowLine">
                <Grid ClipToBounds="False"
                      x:Name="GridRoot"
                      HorizontalAlignment="Stretch">
                    <Border x:Name="BackgroundBorder"
                            IsVisible="{Binding !$self.(ci:MainWindowStylesAssist.IsIslandSeperated)}"
                            Classes="docking line-background"
                            Width="{Binding BackgroundWidth, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType=controls:MainWindowLine}}"
                            Height="{DynamicResource IslandContainerHeight}" />
                    <Grid x:Name="ContentClipBorder" Classes="clip-host">
                        <Panel Classes="animated-resize" ClipToBounds="False">
                            <Grid x:Name="PART_GridWrapper" ClipToBounds="False"
                                  Height="{DynamicResource IslandContainerHeight}"
                                  Classes="docking">
                                <Grid Height="{DynamicResource IslandContainerHeight}"
                                      x:Name="GridContentRoot"
                                      MinWidth="20"
                                      Margin="12 0">
                                    <ContentPresenter
                                        Content="{Binding Content, RelativeSource={RelativeSource AncestorType=controls:MainWindowLine}}" />
                                </Grid>
                            </Grid>
                        </Panel>
                    </Grid>
                </Grid>
            </ControlTemplate>
            <ci:DoubleToThicknessMultiConverter x:Key="DoubleToThicknessMultiConverter" />
        </Style.Resources>

        <Style Selector="^ ci|ComponentPresenter[IsRootComponent=True]">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <Panel>
                        <ContentPresenter Content="{Binding}"/>
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="^ ci|ComponentPresenter[IsRootComponent=True][(ci|MainWindowStylesAssist.IsIslandSeperated)=True]">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <Panel Margin="-2 0">
                        <Border Classes="line-background"/>
                        <Border ClipToBounds="True"
                                MinWidth="40"
                                CornerRadius="{Binding $self.(ci:MainWindowStylesAssist.CornerRadius), Converter={StaticResource SizeDoubleToCornerRadiusConverter}, ConverterParameter=1.0}">
                            <ContentPresenter Content="{Binding}"
                                              Margin="16 0" />
                        </Border>
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>

        <Setter Property="Template" Value="{StaticResource MainWindowLineFullControlTemplate}"/>

        <Style Selector="^[(ci|ComponentPresenter.IsMainWindowLoaded)=True]">
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.150"/>
                        <DoubleTransition Property="BackgroundWidth" Duration="0:0:0.350" Easing="0.22, 1, 0.36, 1"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="^[IsNotificationEnabled=False]">
            <Setter Property="Template" Value="{StaticResource MainWindowLineMinControlTemplate}"/>
            <Setter Property="IsVisible" Value="{Binding IsAllComponentsHid, RelativeSource={RelativeSource Self}, Converter={StaticResource InvertBooleanConverter}}"/>
        </Style>

        <Style Selector="^[IsNotificationEnabled=True]">
            <Style Selector="^ /template/ ContentPresenter#OverlayMaskContent">
            </Style>
            <Style Selector="^ /template/ Grid#GridContentRoot">
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity"
                                          Duration="0:0:0.25">
                            <DoubleTransition.Easing>
                                <SineEaseIn/>
                            </DoubleTransition.Easing>
                        </DoubleTransition>
                    </Transitions>
                </Setter>
                <Setter Property="Opacity" Value="1"/>
            </Style>

            <Style Selector="^:mask-anim">
                <Style Selector="^ /template/ Border#OverlayMask">
                </Style>

                <Style Selector="^:mask-in">
                    <Style Selector="^ /template/ controls|SlantedMaskControl.mask-bg">
                        <Setter Property="IsOpened" Value="True"/>
                    </Style>

                    <Style Selector="^[(ci|MainWindowStylesAssist.IsIslandSeperated)=False] /template/ Border#BackgroundBorderOverlayMask">
                        <Setter Property="BoxShadow" Value="0 8 40 0 #40000000, 0 0 1 0 #10FFFFFF inset"/>
                    </Style>
                    <Style Selector="^[(ci|MainWindowStylesAssist.IsIslandSeperated)=True] /template/ Border#OverlayMaskShadowRoot">
                        <Setter Property="BoxShadow" Value="0 8 40 0 #40000000, 0 0 1 0 #10FFFFFF inset"/>
                    </Style>
                    <Style Selector="^ /template/ ContentPresenter#OverlayMaskContent">
                        <Style.Animations>
                            <Animation Delay="0:0:0.28" Duration="0:0:0.3" IterationCount="1"
                                       FillMode="Both"
                                       Easing="0.22, 1, 0.36, 1">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                            <Animation Delay="0:0:0.28" Duration="0:0:0.8" IterationCount="1"
                                       FillMode="Both"
                                       Easing="0.22, 1, 0.36, 1">
                                <KeyFrame Cue="0%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.08"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.08"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Border#BackgroundBorderOverlayMask">
                        <Style.Animations>
                            <Animation Delay="0:0:0.60" Duration="0:0:0.15" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Grid#GridContentRoot">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Border#GlassHighlightOverlay">
                        <Style.Animations>
                            <Animation Duration="0:0:0.3" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Style>
                <Style Selector="^:mask-out">
                    <Style Selector="^ /template/ controls|SlantedMaskControl.mask-bg">
                        <Setter Property="IsOpened" Value="False"/>
                    </Style>
                    <Style Selector="^ /template/ ContentPresenter#OverlayMaskContent">
                        <Style.Animations>
                            <Animation Duration="0:0:0.22" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                            </Animation>
                            <Animation Duration="0:0:0.22" IterationCount="1"
                                       FillMode="Both"
                                       Easing="0.55, 0, 1, 0.45">
                                <KeyFrame Cue="0%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="ScaleTransform.ScaleX" Value="1.06"/>
                                    <Setter Property="ScaleTransform.ScaleY" Value="1.06"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Border#BackgroundBorderOverlayMask">
                        <Style.Animations>
                            <Animation Duration="0:0:0.12" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                    <Style Selector="^ /template/ Grid#GridContentRoot">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Border#BackgroundBorderOverlayMask">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Border#GlassHighlightOverlay">
                        <Style.Animations>
                            <Animation Delay="0:0:0.1" Duration="0:0:0.25" IterationCount="1"
                                       FillMode="Forward">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Style>
            </Style>
            <Style Selector="^:overlay-anim">
                <Style Selector="^ /template/ Grid#GridOverlay">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity"
                                              Duration="0:0:0.25">
                                <DoubleTransition.Easing>
                                    <SineEaseIn/>
                                </DoubleTransition.Easing>
                            </DoubleTransition>
                        </Transitions>
                    </Setter>
                    <Setter Property="Opacity" Value="0"/>
                </Style>

                <Style Selector="^:overlay-out">
                    <Style Selector="^ /template/ Grid#GridOverlay">
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                    <Style Selector="^ /template/ Grid#GridContentRoot">
                        <Setter Property="Opacity" Value="1"/>
                    </Style>
                </Style>
            </Style>

            <Style Selector="^:overlay-in">
                <Style Selector="^ /template/ Grid#GridOverlay">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
                <Style Selector="^ /template/ Grid#GridContentRoot">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
            </Style>
            <Style Selector="^ /template/ ProgressBar#OverlayTimeProgressBar">
                <Setter Property="MinWidth" Value="0"/>
            </Style>
        </Style>
    </Style>
</Styles>